{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/pipeline", "destination": "/404.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "pipeline.kitebaze.com" }], "destination": "/404.html" }
  ],
  "redirects": [
    { "source": "/pipeline", "has": [{ "type": "host", "value": "kitebaze.com" }], "destination": "https://pipeline.kitebaze.com/", "permanent": false },
    { "source": "/pipeline", "has": [{ "type": "host", "value": "www.kitebaze.com" }], "destination": "https://pipeline.kitebaze.com/", "permanent": false },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about-us", "permanent": true },
    { "source": "/workflow", "destination": "/workflow-build", "permanent": true },
    { "source": "/in-house-agent", "destination": "/bottleneck", "permanent": true },
    { "source": "/workflow-discovery", "destination": "/book-workflow-review", "permanent": true },
    { "source": "/contact-form", "destination": "/contact", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms-of-service", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pipeline.kitebaze.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/pipeline",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/llms-pages/:path*",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*.(jpg|jpeg|png|webp|avif|svg|ico|gif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/:path*.(mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
