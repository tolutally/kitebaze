# Deal pipeline board (/pipeline). Defaults point at Kitebaze's Appwrite project; set these only to override.
VITE_APPWRITE_ENDPOINT=https://tor.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6afdd34c0009ec87e52f
VITE_APPWRITE_DATABASE_ID=crm
VITE_APPWRITE_TEAM_ID=pipeline
# Set to true to use browser-only sample data instead of Appwrite.
VITE_PIPELINE_DEMO=false
